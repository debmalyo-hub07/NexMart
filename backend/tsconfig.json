{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  // Test/QA-only sources stay out of the production build: they import
  // devDependencies (mongodb-memory-server, supertest), which are absent when
  // NODE_ENV=production makes npm skip devDeps (the Render deploy failure).
  // Full type-check of everything lives in tsconfig.test.json (`npm run typecheck`).
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/test/**",
    "src/scripts/previewStorefront.ts"
  ]
}
