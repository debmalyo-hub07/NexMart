# ─────────────────────────────────────────────
# NexMart — Root Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env to version control
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nexmart
# Production: use Atlas → mongodb+srv://<user>:<pass>@cluster.mongodb.net/nexmart

# ── Upstash Redis (for production rate-limiting) ──
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ── Local Redis (BullMQ queues) ───────────────
REDIS_URL=redis://localhost:6379

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Auth & JWT ────────────────────────────────
AUTH_SECRET=change_this_to_a_random_64_char_string
JWT_SECRET=change_this_jwt_secret_minimum_32_chars
DELIVERY_JWT_SECRET=change_this_delivery_secret_32_chars
SESSION_MAXAGE=2592000

# ── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Brevo SMTP) ────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=NexMart <noreply@nexmart.in>

# ── AUTHENTICATION SECRETS ───────────────────────────────────
JWT_SECRET_ADMIN="your_super_secret_admin_key"
JWT_SECRET_CUSTOMER="your_super_secret_customer_key"
JWT_SECRET_AGENT="your_super_secret_agent_key"
JWT_EXPIRES_IN="7d"

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────
LOG_LEVEL=info

# ── Socket.io ─────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000

# ── Invoice Storage ───────────────────────────
INVOICE_STORAGE=cloudinary

# ── Admin Seed ────────────────────────────────
ADMIN_SEED_EMAIL=admin@nexmart.in
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_ENABLED=true
